# QFieldCloud upstream release provenance.
# Source release: https://github.com/opengisch/QFieldCloud/releases/tag/v26.25
# Source commit: https://github.com/opengisch/QFieldCloud/commit/c32bc110f8291b2a32e318528ee46689771630d6
# Official release build: https://github.com/opengisch/QFieldCloud/actions/runs/32261851081
QFIELDCLOUD_RELEASE=v26.25
QFIELDCLOUD_COMMIT=c32bc110f8291b2a32e318528ee46689771630d6
QFIELDCLOUD_PLATFORM=linux/amd64
QFIELDCLOUD_DHPARAM_SHA256=a6e3c01dabf4fe5cb32b20e1f84e55a2aa4309159e102867a1ca8fa7e8acd991

# Official QFieldCloud images. These are platform-specific manifests, not mutable tags.
QFC_APP_IMAGE=docker.io/opengisch/qfieldcloud-app@sha256:b16a02d1a9ab22180335445bd534b7a3b264f4742618b10d1a892f94f7ac88ee
QFC_NGINX_IMAGE=docker.io/opengisch/qfieldcloud-nginx@sha256:78131eea09a02d8ceaa4387ddf705795ff7bb4793d3e65150a27b7d3844e2bd8
QFC_WORKER_WRAPPER_IMAGE=docker.io/opengisch/qfieldcloud-worker-wrapper@sha256:7a91e8294e02d908bf8abc0671bfd9af9e3410a99169b95e81a725e81896ec18
QFC_QGIS3_IMAGE=docker.io/opengisch/qfieldcloud-qgis3@sha256:ef04373b1a4e7e3da52754a8980aab1e96c3ebf37cbc474523bb9aa86b17d363
QFC_QGIS3_EXPECTED_VERSION=3.44.13
QFC_CREATEBUCKETS_IMAGE=docker.io/opengisch/qfieldcloud-createbuckets@sha256:62a91be5edb90fe7dcc108ded4c5a672863c2c7af1eeb1271f4e982ecf4464fb

# The upstream v26.25 qgis4 image was built with QGIS 3 defaults because its build
# arguments were not applied. The lab pilot deliberately has no QGIS 4 image pin.
QFC_QGIS4_IMAGE=disabled.invalid/qfieldcloud-qgis4:v26.25-not-verified

# External images used by the upstream standalone topology, pinned for linux/amd64.
POSTGIS_IMAGE=docker.io/postgis/postgis@sha256:966243672c7d98cb996f26854a790b3b76e3cb77455d6eeb19d72ff82d20e7af
RUSTFS_IMAGE=docker.io/rustfs/rustfs@sha256:e4151ec4728f4d39a714a2c5f6e1f4bc8e0789fe5af4874b95121bae39c6cd12
SMTP4DEV_IMAGE=docker.io/rnwood/smtp4dev@sha256:a9fc3930b16f26cf8fb3f4e20b2924e96b619c141ed895e02581bcf4f631b8c3
OFELIA_IMAGE=docker.io/mcuadros/ofelia@sha256:544718912e78a435ec0cd4c732d4f187ee60f0c45bd0d5dee6117c42aa463b62
MEMCACHED_IMAGE=docker.io/library/memcached@sha256:ccb35654049b320579c935b2b1e9f85ee5a44a39f7610f882f94d7f601a6a50b

# Official Certbot image with direct IPv4 certificate support. The image is the
# linux/amd64 platform manifest for Certbot 5.7.0, not a mutable tag.
# Source: https://hub.docker.com/r/certbot/certbot/tags
CERTBOT_IMAGE=docker.io/certbot/certbot@sha256:d07bd043d61d6bee1114235ac12c2e9a5c54b6931b3ccf5e1174d6c8c4afaa95
CERTBOT_EXPECTED_VERSION=5.7.0
LETSENCRYPT_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
LETSENCRYPT_CERTIFICATE_PROFILE=shortlived

# Official OSGeo PROJ-data release used to populate the worker's transformation
# grid volume. The release archive is flat and includes its license inventory.
# Source: https://github.com/OSGeo/PROJ-data/releases/tag/1.24.0
PROJ_DATA_RELEASE=1.24.0
PROJ_DATA_ARCHIVE_URL=https://github.com/OSGeo/PROJ-data/releases/download/1.24.0/proj-data-1.24.tar.gz
PROJ_DATA_ARCHIVE_SIZE_BYTES=792584182
PROJ_DATA_ARCHIVE_SHA256=eadf412754a2a9a727d79579873fbe7dae802038d4c2a19e452a886d4eddd111

# Docker's signed Ubuntu 24.04 (noble) APT repository versions. The bootstrap
# installs these exact package versions and then places them on hold.
DOCKER_CE_VERSION=5:29.7.2-1~ubuntu.24.04~noble
DOCKER_CE_CLI_VERSION=5:29.7.2-1~ubuntu.24.04~noble
CONTAINERD_IO_VERSION=2.3.3-1~ubuntu.24.04~noble
DOCKER_BUILDX_VERSION=0.36.1-1~ubuntu.24.04~noble
DOCKER_COMPOSE_VERSION=5.5.0-1~ubuntu.24.04~noble
# Exact bytes retrieved from Docker's official Ubuntu signing-key URL and
# verified on 2026-08-23. A future legitimate key rotation must be reviewed.
DOCKER_APT_KEY_SIZE_BYTES=3817
DOCKER_APT_KEY_SHA256=1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570
DOCKER_APT_KEY_FINGERPRINT=9DC858229FC7DD38854AE2D88D81803C0EBFCD88

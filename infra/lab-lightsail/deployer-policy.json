{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyCfnGeo",
      "Effect": "Deny",
      "Action": "cloudformation:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    },
    {
      "Sid": "DenyLsGeo",
      "Effect": "Deny",
      "Action": "lightsail:*",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "ap-northeast-2",
            "us-east-1"
          ]
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "cloudformation:CancelUpdateStack",
        "cloudformation:ContinueUpdateRollback",
        "cloudformation:CreateChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:RollbackStack",
        "cloudformation:SetStackPolicy",
        "cloudformation:UpdateStack",
        "cloudformation:*StackSet*",
        "cloudformation:*StackInstances*"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:ListStacks",
        "cloudformation:ValidateTemplate"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "cloudformation:CreateStack",
      "Resource": "arn:aws:cloudformation:ap-northeast-2:*:stack/qfieldcloud-lab-pilot/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:RequestTag/Project": "qfieldcloud-self-hosting",
          "aws:RequestTag/DeploymentProfile": "lab-lightsail"
        },
        "ForAllValues:StringEquals": {
          "cloudformation:ResourceTypes": [
            "AWS::CloudFormation::WaitCondition",
            "AWS::CloudFormation::WaitConditionHandle",
            "AWS::Lightsail::Alarm",
            "AWS::Lightsail::Instance",
            "AWS::Lightsail::StaticIp"
          ]
        },
        "Null": {
          "cloudformation:ResourceTypes": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:DescribeStacks",
        "cloudformation:GetStackPolicy",
        "cloudformation:GetTemplate",
        "cloudformation:ListStackResources"
      ],
      "Resource": "arn:aws:cloudformation:ap-northeast-2:*:stack/qfieldcloud-lab-pilot/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    },
    {
      "Sid": "ReadLsSeoul",
      "Effect": "Allow",
      "Action": [
        "lightsail:GetAlarms",
        "lightsail:GetBlueprints",
        "lightsail:GetBundles",
        "lightsail:GetDisks",
        "lightsail:GetInstance",
        "lightsail:GetInstances",
        "lightsail:GetInstanceSnapshots",
        "lightsail:GetInstanceState",
        "lightsail:GetKeyPairs",
        "lightsail:GetLoadBalancers",
        "lightsail:GetRegions",
        "lightsail:GetStaticIp",
        "lightsail:GetStaticIps"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    },
    {
      "Sid": "ReadLsCdn",
      "Effect": "Allow",
      "Action": "lightsail:GetDistributions",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "lightsail:CreateInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:RequestTag/Project": "qfieldcloud-self-hosting",
          "aws:RequestTag/DeploymentProfile": "lab-lightsail",
          "aws:RequestTag/ManagedBy": "CloudFormation",
          "aws:RequestTag/CloudFormationStack": "qfieldcloud-lab-pilot"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "lightsail:TagResource",
      "Resource": [
        "arn:aws:lightsail:ap-northeast-2:*:Alarm/*",
        "arn:aws:lightsail:ap-northeast-2:*:Instance/*",
        "arn:aws:lightsail:ap-northeast-2:*:StaticIp/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageVm",
      "Effect": "Allow",
      "Action": [
        "lightsail:DeleteInstance",
        "lightsail:PutInstancePublicPorts"
      ],
      "Resource": "arn:aws:lightsail:ap-northeast-2:*:Instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:ResourceTag/Project": "qfieldcloud-self-hosting",
          "aws:ResourceTag/DeploymentProfile": "lab-lightsail",
          "aws:ResourceTag/ManagedBy": "CloudFormation",
          "aws:ResourceTag/CloudFormationStack": "qfieldcloud-lab-pilot"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "OperateVm",
      "Effect": "Allow",
      "Action": [
        "lightsail:GetInstanceAccessDetails",
        "lightsail:RebootInstance",
        "lightsail:StartInstance",
        "lightsail:StopInstance"
      ],
      "Resource": "arn:aws:lightsail:ap-northeast-2:*:Instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:ResourceTag/Project": "qfieldcloud-self-hosting",
          "aws:ResourceTag/DeploymentProfile": "lab-lightsail",
          "aws:ResourceTag/ManagedBy": "CloudFormation",
          "aws:ResourceTag/CloudFormationStack": "qfieldcloud-lab-pilot"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "lightsail:AttachStaticIp",
      "Resource": "arn:aws:lightsail:ap-northeast-2:*:Instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:ResourceTag/Project": "qfieldcloud-self-hosting",
          "aws:ResourceTag/DeploymentProfile": "lab-lightsail",
          "aws:ResourceTag/ManagedBy": "CloudFormation",
          "aws:ResourceTag/CloudFormationStack": "qfieldcloud-lab-pilot"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "lightsail:AttachStaticIp",
      "Resource": "arn:aws:lightsail:ap-northeast-2:*:StaticIp/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "lightsail:AllocateStaticIp",
        "lightsail:DisableAddOn",
        "lightsail:EnableAddOn"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "lightsail:DetachStaticIp",
        "lightsail:ReleaseStaticIp"
      ],
      "Resource": "arn:aws:lightsail:ap-northeast-2:*:StaticIp/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "lightsail:DeleteAlarm",
        "lightsail:PutAlarm"
      ],
      "Resource": "arn:aws:lightsail:ap-northeast-2:*:Alarm/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        },
        "ForAnyValue:StringEquals": {
          "aws:CalledVia": "cloudformation.amazonaws.com"
        }
      }
    }
  ]
}
